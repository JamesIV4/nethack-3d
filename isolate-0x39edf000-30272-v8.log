script-source,86,file:///tmp/test_evilhack.mjs,import Module from '/home/simon/repos/nethack-3d/public/evilhack.js';\n\nconst mod = await Module({\n  print: (s) => console.log('[stdout]'\x2C s)\x2C\n  printErr: (s) => console.error('[stderr]'\x2C s)\x2C\n  noInitialRun: true\x2C\n  preRun: [(m) => {\n    m.ENV.HACKDIR = '/';\n    m.ENV.NETHACKDIR = '/';\n    m.ENV.NETHACKOPTIONS = 'role:Valkyrie\x2Crace:human\x2Cgender:female\x2Calign:neutral\x2Cname:TestUser\x2Cwindowtype:shim';\n  }]\x2C\n});\n\n// Register a minimal callback that auto-answers everything\nglobalThis.nethackCallback = async (name\x2C ...args) => {\n  console.log('[CB]'\x2C name\x2C args.slice(0\x2C4));\n  if (name === 'shim_nhgetch' || name === 'shim_get_nh_event') return 32;\n  if (name === 'shim_yn_function') return args[2] ?? 121; // default answer\n  if (name === 'shim_getlin') { return 0; }\n  if (name === 'shim_select_menu') return 0;\n  return 0;\n};\n\nconst setCallback = mod.cwrap('shim_graphics_set_callback'\x2C null\x2C ['string']);\nsetCallback('nethackCallback');\n\ntry {\n  const argv0 = mod._malloc(8); mod.stringToUTF8('nethack'\x2C argv0\x2C 8);\n  const argv = mod._malloc(8); mod.setValue(argv\x2C argv0\x2C '*'); mod.setValue(argv+4\x2C 0\x2C '*');\n  mod._main(1\x2C argv);\n} catch(e) {\n  console.error('[EXCEPTION]'\x2C e.message\x2C e.stack?.split('\\n').slice(0\x2C5).join('\\n'));\n}\n
